# Trend Radar — environment variables
#
# Phase 0 requires NONE of these to boot: src/config/env.ts only enforces that
# already-supplied values are well-formed. Variables become required in
# practice once the phase that uses them is implemented (see
# docs/IMPLEMENTATION_PLAN.md §27 and §28). Copy this file to .env.local and
# fill in only what the phase you're working on needs.

# ---- Core app -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Public URL this app is deployed at; needed once webhooks exist (Phase 5/8/9).
APP_BASE_URL=

# ---- Database (Neon Postgres) — needed from Phase 3 -----------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---- Telegram — needed from Phase 8 ----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REPORT_CHAT_ID=

# ---- Scheduling / webhooks — needed from Phase 5 ---------------------------
CRON_SECRET=
PROVIDER_WEBHOOK_SECRET=

# ---- Social data providers — needed from Phase 4 (routing decided in Phase 1) ---
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_DATASET_TIKTOK_POSTS=
BRIGHTDATA_DATASET_INSTAGRAM_POSTS=

APIFY_API_TOKEN=
APIFY_ACTOR_TIKTOK=
APIFY_ACTOR_INSTAGRAM=

# One of: brightdata | apify
PROVIDER_TIKTOK_PRIMARY=
PROVIDER_TIKTOK_FALLBACK=
PROVIDER_INSTAGRAM_PRIMARY=
PROVIDER_INSTAGRAM_FALLBACK=
PROVIDER_COUNTRY=US

# ---- Market / crawl budget --------------------------------------------------
# "global" is a real market value (undifferentiated worldwide discovery), not
# a placeholder for "unconfigured". See docs/IMPLEMENTATION_PLAN.md ADR-020.
DEFAULT_MARKET=global

# One of: FREE | LEAN | STANDARD
BUDGET_PROFILE=LEAN
BUDGET_MONTHLY_USD_MAX=10
BUDGET_APIFY_MONTHLY_USD_MAX=4.5

# ---- Reporting ---------------------------------------------------------------
REPORT_TZ=Europe/Moscow
REPORT_LOCAL_TIME=09:00

# ---- Optional AI (OpenRouter) — never required; see ADR-002 ----------------
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
AI_AUTO_DAILY=false
AI_TIMEOUT_MS=45000
